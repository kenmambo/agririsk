# Keep the build context small and secrets out of the image.
.git
.gitignore
.github
.venv
venv
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
# Secrets must never be baked into an image layer.
.env
*.local
logs/
# The 19 GB host-side feed cache and live artefacts stay on the host;
# the image uses deploy/seed/ instead.
data/
models/
# Not needed at serve time (api/dashboard never ingest or train).
tests/
scripts/
Dockerfile
docker-compose.yml
