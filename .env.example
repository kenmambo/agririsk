# Copy to `.env` and adjust. All variables are optional; sensible defaults exist
# in src/agrik/settings.py. Any field can be overridden via the AGRIK_ prefix.

AGRIK_ENVIRONMENT=development
AGRIK_LOG_LEVEL=INFO

# Paths are resolved relative to the working directory (repo root) by default.
# AGRIK_DATA_ROOT=data
# AGRIK_MODELS_DIR=models
# AGRIK_CONFIG_DIR=config

# --- M1 real feeds (optional) -------------------------------------------------
# NASA Earthdata Login (free: https://urs.earthdata.nasa.gov) is required only
# for MODIS downloads. CHIRPS works without any credentials.
# Preferred: application token (urs.earthdata.nasa.gov -> Profile ->
# Applications -> "Generate Token"); works even when MFA is enabled.
# AGRIK_EARTHDATA_TOKEN=
# Fallback (not used if a token is set; fails for MFA/SSO-only accounts):
# AGRIK_EARTHDATA_USERNAME=
# AGRIK_EARTHDATA_PASSWORD=
# AGRIK_HTTP_TIMEOUT_S=180
